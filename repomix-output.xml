    vstats = youtube.videos().list(
        part="statistics,contentDetails,snippet",
        id=",".join(v[0] for v in vids)
    ).execute()
    sm = {it["id"]: it for it in vstats.get("items", [])}
    rows = []
    for vid, vtitle, pub in vids:
        item = sm.get(vid, {})
