  margin: 0 auto;
  padding: 32px 24px 80px;
}

/* ──────────── Hero header ──────────── */
.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 36px;
  padding: 24px 28px;
