  opacity: 0.5;
}
.kpi-label {
  font-size: 0.72rem;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--text-3);
  font-weight: 700;
  margin-bottom: 10px;
}
.kpi-value {
  font-size: 2.4rem;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  background: linear-gradient(135deg, #fff, var(--cyan-glow));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: -0.02em;
  margin-bottom: 4px;
  line-height: 1.05;
}
.kpi-unit { font-size: 0.95rem; color: var(--text-2); font-weight: 600; }
.kpi-sub { font-size: 0.78rem; color: var(--text-3); margin-top: 6px; }
.kpi.month .kpi-value { background: linear-gradient(135deg, #fff, var(--violet-glow)); -webkit-background-clip: text; background-clip: text; color: transparent; }
.kpi.today .kpi-value { background: linear-gradient(135deg, #fff, var(--amber)); -webkit-background-clip: text; background-clip: text; color: transparent; }

/* ──────────── Section ──────────── */
.section {
  margin-bottom: 28px;
}
.section h2 {
  font-size: 1.05rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
  color: var(--text-1);
  margin-bottom: 14px;
  display: flex;
  align-items: center;
  gap: 8px;
}
.section h2::before {
  content: '';
  width: 4px; height: 18px;
  background: linear-gradient(180deg, var(--cyan), var(--violet));
  border-radius: 2px;
  box-shadow: 0 0 12px var(--cyan);
}

.row {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 20px;
}

.card {
  background: linear-gradient(145deg, rgba(11, 17, 48, 0.7), rgba(19, 27, 74, 0.5));
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 22px;
  backdrop-filter: blur(12px);
  position: relative;
  overflow: hidden;
}
.card::before {
  content: '';
  position: absolute;
  top: 0; left: 0;
  width: 60%; height: 1px;
  background: linear-gradient(90deg, var(--cyan), transparent);
}

/* ──────────── Sparkline ──────────── */
.spark-wrap { padding: 8px 0; }
.spark-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12px;
}
.spark-meta .total {
  font-size: 1.2rem;
  font-weight: 800;
  color: var(--cyan-glow);
}
.spark-svg { width: 100%; height: 160px; }
.spark-area { fill: url(#gradArea); }
.spark-line { stroke: var(--cyan-glow); stroke-width: 2.5; fill: none; filter: drop-shadow(0 0 6px var(--cyan)); }
