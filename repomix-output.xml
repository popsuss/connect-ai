/* v2.89.137 — 매출 대시보드 (매트릭스 + 네온 사이버 풍).
   거대한 카운터, 게임별 도넛, 일별 막대, 라이브 거래 피드.
   글리프 비 배경, 펄스, hover glow, count-up 애니메이션. */

:root {
  --bg-0: #050816;
  --bg-1: #0a0f24;
  --bg-2: #131b3f;
  --text-0: #ffffff;
  --text-1: #cbd5e1;
  --text-2: #94a3b8;
  --text-3: #64748b;
  --cyan: #22d3ee;
  --cyan-glow: #67e8f9;
  --cyan-deep: #0891b2;
  --violet: #a78bfa;
  --violet-glow: #c4b5fd;
  --emerald: #34d399;
  --amber: #fbbf24;
  --rose: #f43f5e;
  --grid: rgba(103, 232, 249, 0.04);
  --border: rgba(103, 232, 249, 0.15);
  --border-strong: rgba(103, 232, 249, 0.35);
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body {
  background: radial-gradient(ellipse at top left, var(--bg-2) 0%, var(--bg-0) 40%);
  color: var(--text-0);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
