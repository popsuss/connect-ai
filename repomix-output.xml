    # 상위 영상 제목 키워드
    top_title_words = Counter()
    stop_kr = {'그리고','근데','너무','진짜','정말','내가','지금','이거','저는','제가','우리'}
    stop_en = {'this','that','and','the','for','with','have','will','your','from','about'}
