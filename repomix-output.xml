@media (max-width: 700px) {
  .kpi-strip { grid-template-columns: repeat(2, 1fr); }
  .kpi-cell:nth-child(2n) { border-right: none; }
}

/* YouTube card body — visual-first: large circular thumbnail centered with
   bigger channel name. Stats use icons instead of text labels. */
.yt-channel {
  display: flex; flex-direction: column; align-items: center; gap: 10px;
  padding: 8px 0 4px;
}
.yt-thumb {
  width: 96px; height: 96px; border-radius: 50%;
  background: var(--bg-1); border: 2px solid var(--accent-glow);
  background-size: cover; background-position: center;
  box-shadow: 0 0 36px var(--accent-glow), inset 0 0 0 1px rgba(255,255,255,.06);
}
.yt-channel-name { font-size: 18px; font-weight: 800; color: var(--bright); letter-spacing: -.3px; text-align: center; }
.yt-channel-desc { display: none; }   /* removed — visual focus on name + thumb */
.yt-stats {
  display: grid; grid-template-columns: repeat(3, 1fr);
  gap: 10px; margin-top: 14px;
}
.yt-stat {
  background: rgba(0,0,0,.25); border: 1px solid var(--line);
  border-radius: 10px; padding: 12px 8px; text-align: center;
  display: flex; flex-direction: column; align-items: center; gap: 4px;
}
.yt-stat-icon { font-size: 20px; line-height: 1; opacity: .9; }
.yt-stat .num { font-size: 18px; font-weight: 700; color: var(--bright); font-variant-numeric: tabular-nums; }
.yt-stat .lbl { display: none; }   /* icon replaces label */

/* Tasks list */
/* v2.87 — Visual task tiles. Each task = grid cell with HUGE agent emoji,
   minimal text. Priority shown as left border color, status as colored ring
   around the emoji, due-date as floating badge — no labels needed. */
.task-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(110px, 1fr)); gap: 10px; }
.task-row {
  position: relative; aspect-ratio: 1/1.05;
  padding: 10px 8px 8px;
  border-radius: 12px;
  background: rgba(255,255,255,.025);
  border: 1.5px solid var(--task-color, var(--line));
  display: flex; flex-direction: column; align-items: center; justify-content: space-between;
  transition: transform .2s, box-shadow .2s;
  cursor: default; overflow: hidden;
}
.task-row:hover { transform: translateY(-2px); box-shadow: 0 8px 22px rgba(0,0,0,.4), 0 0 16px var(--task-color, transparent); }
.task-row.urgent { --task-color: var(--danger); }
.task-row.high   { --task-color: var(--gold); }
.task-row.normal { --task-color: var(--accent-2); }
.task-row.low    { --task-color: rgba(255,255,255,.1); }
.task-pri-dot { display: none; }   /* legacy — replaced by border color */
.task-emoji-big {
  font-size: 36px; line-height: 1;
  filter: drop-shadow(0 2px 6px var(--task-color, transparent));
  margin: 6px 0 4px;
}
.task-row.urgent .task-emoji-big::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 50% 35%, rgba(239,68,68,.18), transparent 60%);
  pointer-events: none; animation: pulse 1.6s ease-in-out infinite;
}
.task-title {
  font-size: 11px; color: var(--bright); line-height: 1.25;
  text-align: center; font-weight: 600;
  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
  padding: 0 2px;
}
.task-meta { display: none; }   /* legacy — info now in icon badges */
.task-due-badge {
  position: absolute; top: 6px; right: 6px;
  font-size: 9px; font-weight: 700;
  background: var(--task-color, rgba(0,0,0,.5));
  color: #000; padding: 2px 6px; border-radius: 999px;
  box-shadow: 0 0 6px var(--task-color, transparent);
}
/* v2.88.4 — 취소 버튼 (호버 시에만 보임, 평소엔 숨김) */
.task-cancel-btn {
  position: absolute; bottom: 4px; right: 4px;
  width: 22px; height: 22px; border-radius: 50%;
  background: rgba(239,68,68,.18); border: 1px solid rgba(239,68,68,.4);
  color: #ef4444; font-size: 12px; font-weight: 700;
  cursor: pointer; display: flex; align-items: center; justify-content: center;
  opacity: 0; transition: all .15s; padding: 0;
}
.task-row:hover .task-cancel-btn { opacity: 1; }
.task-cancel-btn:hover { background: rgba(239,68,68,.32); transform: scale(1.1); }
.task-recurrence-mark {
  position: absolute; top: 6px; left: 6px;
  font-size: 12px; opacity: .8;
}

/* Approvals — compact visual queue. Each approval = vertical card with
   gold-pink gradient bar, agent face/emoji top-left, big title, action
   icons replace labeled buttons. */
.apr-list { display: grid; grid-template-columns: 1fr; gap: 10px; }
.apr-card {
  position: relative;
  background: linear-gradient(135deg, rgba(251,191,36,.06) 0%, rgba(255,77,152,.04) 100%);
  border: 1px solid rgba(251,191,36,.20);
  border-radius: 12px; padding: 12px 14px;
  display: grid; grid-template-columns: 44px 1fr auto; gap: 12px; align-items: center;
}
.apr-card::before {
  content: ''; position: absolute; left: 0; top: 8px; bottom: 8px;
  width: 3px; border-radius: 0 4px 4px 0;
  background: linear-gradient(180deg, var(--gold), var(--magenta));
}
.apr-emoji-tile {
  width: 44px; height: 44px; border-radius: 12px;
  background: linear-gradient(135deg, rgba(251,191,36,.15), rgba(255,77,152,.1));
  border: 1px solid rgba(251,191,36,.3);
  display: flex; align-items: center; justify-content: center;
  font-size: 24px;
  flex-shrink: 0;
}
.apr-head { display: none; }   /* replaced by emoji tile */
.apr-agent { display: none; }   /* implicit from emoji */
.apr-title-block { min-width: 0; }
.apr-title { font-size: 13.5px; font-weight: 700; color: var(--bright); margin: 0;
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.apr-summary {
  font-size: 11px; color: var(--dim); margin-top: 2px;
  display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden;
  line-height: 1.4;
}
.apr-summary::after { content: none; }
.apr-card:hover .apr-summary { -webkit-line-clamp: 3; }
.apr-actions { display: flex; gap: 4px; margin-top: 0; }
.apr-icon-btn {
  width: 36px; height: 36px; border-radius: 10px;
  display: flex; align-items: center; justify-content: center;
  font-size: 16px; cursor: pointer;
  background: rgba(255,255,255,.04); border: 1px solid var(--line);
  transition: all .15s;
}
.apr-icon-btn:hover { transform: translateY(-1px); }
.apr-icon-btn.approve { color: #00ff8b; border-color: rgba(0,255,139,.3); }
.apr-icon-btn.approve:hover { background: rgba(0,255,139,.15); box-shadow: 0 0 12px rgba(0,255,139,.25); }
.apr-icon-btn.reject { color: #ef4444; border-color: rgba(239,68,68,.3); }
.apr-icon-btn.reject:hover { background: rgba(239,68,68,.15); box-shadow: 0 0 12px rgba(239,68,68,.25); }
.apr-icon-btn.detail { color: var(--dim); }
.apr-icon-btn.detail:hover { color: var(--bright); background: rgba(255,255,255,.08); }

/* Analytics */
.ana-totals { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-bottom: 12px; }
.ana-cell {
  background: rgba(0,0,0,.25); border: 1px solid var(--line);
  border-radius: 10px; padding: 10px 12px;
  display: flex; align-items: center; gap: 10px;
}
.ana-cell .ana-icon { font-size: 22px; line-height: 1; opacity: .9; flex-shrink: 0; }
.ana-cell .num { font-size: 19px; font-weight: 700; color: var(--bright); font-variant-numeric: tabular-nums; }
.ana-cell .lbl { font-size: 10px; color: var(--dim); text-transform: uppercase; letter-spacing: .6px; }
.ana-section-title { margin: 14px 0 6px; }
.ana-section-icon { font-size: 18px; opacity: .8; }
.ana-bar-row { display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: 11.5px; }
.ana-bar-row .nm { color: var(--text); }
.ana-bar-row .vl { color: var(--accent); font-variant-numeric: tabular-nums; font-weight: 600; }
.ana-bar { height: 4px; background: rgba(255,255,255,.06); border-radius: 999px; margin: 2px 0 8px; overflow: hidden; }
.ana-bar > span { display: block; height: 100%; background: linear-gradient(90deg, var(--accent), var(--accent-2)); border-radius: 999px; }
.ana-section-title { font-size: 10px; color: var(--dim); text-transform: uppercase; letter-spacing: 1px; margin: 14px 0 6px; }

.ana-empty {
  text-align: center; padding: 20px 16px;
  border: 1px dashed var(--line-2); border-radius: 10px;
}
.ana-empty .icon { font-size: 22px; margin-bottom: 6px; }
.ana-empty .msg { font-size: 12px; color: var(--dim); margin-bottom: 12px; }

/* Video grid */
.video-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
  gap: 12px;
}
.video-card {
  background: rgba(0,0,0,.25); border: 1px solid var(--line);
  border-radius: 10px; overflow: hidden;
  transition: transform .2s, box-shadow .2s;
  cursor: pointer;
}
.video-card:hover { transform: translateY(-3px); box-shadow: 0 12px 28px rgba(0,0,0,.5); border-color: var(--accent-glow); }
.video-thumb {
  aspect-ratio: 16 / 9; background: var(--bg-1); background-size: cover; background-position: center;
  position: relative;
}
.video-thumb::after {
  content: ''; position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 60%, rgba(0,0,0,.6) 100%);
}
.video-meta { padding: 10px 12px; }
.video-title { font-size: 12px; font-weight: 600; color: var(--text); line-height: 1.4; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; min-height: 33px; }
.video-stats { font-size: 10.5px; color: var(--dim); margin-top: 6px; display: flex; gap: 10px; font-variant-numeric: tabular-nums; }

/* Competitors */
.add-row { display: flex; gap: 8px; margin-bottom: 12px; }
.add-row input {
  flex: 1; background: rgba(0,0,0,.3); border: 1px solid var(--line);
  border-radius: 9px; padding: 9px 12px; color: var(--text); font-size: 12.5px;
  font-family: inherit;
}
.add-row input:focus { outline: none; border-color: var(--accent-glow); box-shadow: 0 0 0 3px rgba(251,191,36,.10); }
.comp-list { display: flex; flex-direction: column; gap: 8px; }
.comp-row {
  display: grid; grid-template-columns: 40px 1fr auto auto; gap: 12px; align-items: center;
  padding: 10px 12px; background: rgba(255,255,255,.02);
  border: 1px solid var(--line); border-radius: 10px;
}
.comp-thumb {
  width: 40px; height: 40px; border-radius: 50%;
  background: var(--bg-1); background-size: cover; background-position: center;
  border: 1px solid var(--line);
}
.comp-name { font-size: 12.5px; font-weight: 600; color: var(--text); }
.comp-stats { font-size: 10.5px; color: var(--dim); margin-top: 2px; font-variant-numeric: tabular-nums; }
.comp-delta { font-size: 11px; font-weight: 600; font-variant-numeric: tabular-nums; }
.comp-delta.up { color: var(--ok); }
.comp-delta.down { color: var(--danger); }
.comp-rm { background: transparent; border: 1px solid var(--line); color: var(--muted); border-radius: 8px; padding: 5px 9px; cursor: pointer; font-family: inherit; font-size: 11px; transition: all .15s; }
.comp-rm:hover { color: var(--danger); border-color: rgba(255,82,96,.4); }

/* v2.86: 우리 팀 hero card — slightly more glow than other cards so it
   feels like the page's anchor element. */
.hero-team { background: linear-gradient(180deg, rgba(251,191,36,.05), var(--bg-2)); }
.hero-team::before { opacity: .55; height: 2px; }

/* v2.77 — Visual-first team grid. Cards become character tiles: face photo
   dominates, name overlaid on bottom gradient, status conveyed by colored
   border glow (no text). Hover reveals specialty in a tooltip layer. */
.team-grid {
  display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
  gap: 12px;
}
.agent-card {
  position: relative; aspect-ratio: 3/4;
  background: rgba(0,0,0,.35); border: 1.5px solid var(--agent-color, var(--line));
  border-radius: 14px; overflow: hidden;
  transition: transform .25s cubic-bezier(.16,1,.3,1), box-shadow .25s, border-color .25s;
  cursor: pointer;
  box-shadow: 0 4px 14px rgba(0,0,0,.35), 0 0 0 1px rgba(255,255,255,.02);
}
.agent-card:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 14px 36px rgba(0,0,0,.55), 0 0 24px var(--agent-color, transparent);
  z-index: 2;
}
.agent-card .agent-photo {
  position: absolute; inset: 0;
  background-size: cover; background-position: center 20%;
  filter: saturate(1.05);
}
.agent-card .agent-photo.no-photo {
  display: flex; align-items: center; justify-content: center;
  font-size: 64px;
  background: linear-gradient(135deg, var(--agent-color, rgba(255,255,255,.06)) 0%, rgba(0,0,0,.3) 100%);
}
.agent-card .agent-photo.no-photo::after {
  content: ''; position: absolute; inset: 0;
  background: radial-gradient(circle at 50% 35%, var(--agent-color, transparent) 0%, transparent 60%);
  opacity: .35;
}
.agent-card .agent-overlay {
  position: absolute; inset: 0;
  background: linear-gradient(180deg, transparent 50%, rgba(0,0,0,.55) 78%, rgba(0,0,0,.92) 100%);
  pointer-events: none;
}
.agent-card .agent-name-strip {
  position: absolute; left: 0; right: 0; bottom: 0;
  padding: 10px 12px 11px;
  font-size: 14px; font-weight: 700; color: #fff; line-height: 1.15;
  letter-spacing: -.2px;
  text-shadow: 0 2px 8px rgba(0,0,0,.7);
  display: flex; flex-direction: column; gap: 2px;
}
.agent-card .agent-role-mini {
  font-size: 9.5px; color: rgba(255,255,255,.75); font-weight: 500;
  text-transform: uppercase; letter-spacing: .8px;
}
/* Floating task badge — only renders when openTasks > 0 */
.agent-task-badge {
  position: absolute; top: 8px; right: 8px;
  min-width: 22px; height: 22px; border-radius: 11px;
  background: var(--agent-color, var(--accent));
  color: #000; font-size: 11px; font-weight: 800;
  display: flex; align-items: center; justify-content: center;
  padding: 0 6px;
  box-shadow: 0 2px 8px rgba(0,0,0,.5), 0 0 12px var(--agent-color, transparent);
  z-index: 3;
}
/* Hover-revealed tagline tooltip — keeps cards visually clean by default */
.agent-card .agent-hover-info {
  position: absolute; left: 8px; right: 8px; top: 8px;
  padding: 8px 10px; border-radius: 10px;
  background: rgba(0,0,0,.85); backdrop-filter: blur(8px);
  font-size: 10.5px; color: #fff; line-height: 1.4;
  opacity: 0; transform: translateY(-4px);
  transition: opacity .2s, transform .2s;
  pointer-events: none;
  border: 1px solid var(--agent-color, rgba(255,255,255,.12));
}
.agent-card:hover .agent-hover-info { opacity: 1; transform: translateY(0); }
/* Recent activity dot — small bottom-left indicator if agent has been active */
.agent-active-dot {
  position: absolute; left: 10px; top: 10px;
  width: 8px; height: 8px; border-radius: 50%;
  background: var(--agent-color, #00ff8b);
  box-shadow: 0 0 8px var(--agent-color, currentColor);
  animation: agentDotPulse 1.6s ease-in-out infinite;
  z-index: 3;
}
@keyframes agentDotPulse { 0%,100%{opacity:.5} 50%{opacity:1} }

/* Activity log */
.log {
  font-family: 'SF Mono', 'JetBrains Mono', monospace;
  font-size: 10.5px; line-height: 1.6;
  color: var(--dim);
  white-space: pre-wrap; word-break: break-word;
  max-height: 360px; overflow-y: auto;
  background: rgba(0,0,0,.3); border-radius: 10px; padding: 12px;
  border: 1px solid var(--line);
}
.log::-webkit-scrollbar { width: 4px; }
.log::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 2px; }

/* Empty / skeleton states */
.empty {
  text-align: center; padding: 28px 20px; color: var(--dim);
  border: 1px dashed var(--line); border-radius: 12px;
  font-size: 12.5px;
}
.empty.subtle { padding: 16px; font-size: 11.5px; }
.skeleton {
  border-radius: 10px;
  background: linear-gradient(90deg, var(--bg-2) 0%, var(--bg-3) 50%, var(--bg-2) 100%);
  background-size: 200% 100%;
  animation: shimmer 1.4s linear infinite;
}
.skel-md { height: 100px; }
.skel-lg { height: 180px; }
@keyframes shimmer {
  from { background-position: 200% 0; }
  to   { background-position: -200% 0; }
}

/* Toast */
.toast {
  position: fixed; bottom: 24px; left: 50%; transform: translateX(-50%);
  background: var(--bg-3); color: var(--text);
  border: 1px solid var(--accent-glow); border-radius: 10px;
  padding: 10px 18px; font-size: 12.5px;
  box-shadow: 0 12px 36px rgba(0,0,0,.6);
  opacity: 0; pointer-events: none; transition: opacity .25s, transform .25s;
  z-index: 100;
}
.toast.show { opacity: 1; transform: translateX(-50%) translateY(-4px); }
.toast.err { border-color: rgba(255,82,96,.5); }

::-webkit-scrollbar { width: 8px; height: 8px; }
::-webkit-scrollbar-thumb { background: var(--line-2); border-radius: 4px; }
::-webkit-scrollbar-track { background: transparent; }

/* ───── v2.87.7 — 에이전트 상세 모달 (대시보드 인앱) ───── */
.adm-backdrop{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.82);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);padding:24px;animation:admIn .25s ease-out;transition:opacity .2s}
@keyframes admIn{from{opacity:0}to{opacity:1}}
.adm-modal{position:relative;width:min(440px,100%);max-height:92vh;overflow-y:auto;display:flex;flex-direction:column;align-items:center;padding:0 0 22px;background:linear-gradient(180deg,rgba(20,20,26,.98),rgba(8,8,12,.99));border:1px solid rgba(255,255,255,.06);border-radius:24px;box-shadow:0 30px 80px rgba(0,0,0,.7),0 0 0 1px var(--ag-glow,transparent),0 0 60px var(--ag-glow,transparent);animation:admModalIn .35s cubic-bezier(.16,1,.3,1)}
@keyframes admModalIn{from{transform:translateY(20px) scale(.96);opacity:0}to{transform:none;opacity:1}}
.adm-modal::-webkit-scrollbar{width:6px}
.adm-modal::-webkit-scrollbar-thumb{background:rgba(255,255,255,.08);border-radius:3px}
/* Close × — floats top-right */
.adm-close{position:absolute;top:14px;right:14px;background:rgba(0,0,0,.5);border:1px solid rgba(255,255,255,.08);color:#fff;width:34px;height:34px;border-radius:50%;font-size:18px;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .15s;z-index:5;backdrop-filter:blur(8px)}
.adm-close:hover{background:rgba(255,255,255,.15);transform:scale(1.08)}
/* Hero — full-width photo (200px tall) or emoji on color gradient */
.adm-hero{width:100%;height:200px;background-size:cover;background-position:center 22%;border-radius:24px 24px 0 0;position:relative;flex-shrink:0}
.adm-hero::after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,transparent 60%,rgba(8,8,12,.6) 100%);border-radius:24px 24px 0 0}
.adm-hero.adm-hero-emoji{background:linear-gradient(135deg,var(--ag-glow,rgba(255,255,255,.06)),rgba(255,255,255,.02));display:flex;align-items:center;justify-content:center}
.adm-hero-emoji-glyph{font-size:96px;filter:drop-shadow(0 4px 16px rgba(0,0,0,.5))}
/* Identity */
.adm-name{font-size:24px;font-weight:800;color:#fff;letter-spacing:-.4px;margin-top:18px}
.adm-role{font-size:11px;color:var(--dim);text-transform:uppercase;letter-spacing:1.4px;margin-top:4px;font-weight:600}
.adm-tagline{font-size:13px;color:var(--text);margin:10px 24px 0;line-height:1.5;text-align:center;padding:9px 13px;background:rgba(255,255,255,.03);border-left:3px solid var(--ag,var(--accent));border-radius:8px;max-width:calc(100% - 48px)}
/* Stats — 3 big tiles */
.adm-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:18px 22px 6px;width:calc(100% - 44px)}
.adm-stat{background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.06);border-radius:12px;padding:14px 8px;display:flex;flex-direction:column;align-items:center;gap:4px;transition:all .2s}
.adm-stat:hover{transform:translateY(-1px);background:rgba(255,255,255,.05);border-color:var(--ag,rgba(255,255,255,.15))}
.adm-stat-icon{font-size:22px;line-height:1;opacity:.95}
.adm-stat-num{font-size:20px;font-weight:800;color:#fff;font-variant-numeric:tabular-nums}
/* Self-RAG 상태 칩 */
.adm-rag-row{display:flex;justify-content:center;margin:14px 22px 0;width:calc(100% - 44px)}
.adm-rag-chip{font-family:inherit;font-size:11.5px;font-weight:700;padding:7px 14px;border-radius:999px;letter-spacing:.3px;display:inline-flex;align-items:center;gap:7px;cursor:pointer;transition:all .2s;outline:none}
.adm-rag-chip:hover{transform:translateY(-1px);filter:brightness(1.15)}
.adm-rag-chip:active{transform:translateY(0)}
.adm-rag-chip.on{background:linear-gradient(135deg,rgba(168,85,247,.22),rgba(217,70,239,.14));color:#F3E8FF;border:1px solid rgba(168,85,247,.55);box-shadow:0 0 18px rgba(168,85,247,.32)}
.adm-rag-chip.off{background:rgba(255,255,255,.04);color:var(--dim);border:1px solid rgba(255,255,255,.1)}
.adm-rag-chip-dot{width:7px;height:7px;border-radius:50%;background:currentColor;box-shadow:0 0 6px currentColor;flex-shrink:0;opacity:.85}
.adm-rag-chip.on .adm-rag-chip-dot{animation:admRagPulse 1.6s ease-in-out infinite}
@keyframes admRagPulse{0%,100%{opacity:.6}50%{opacity:1}}
