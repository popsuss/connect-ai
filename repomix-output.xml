function showLoader(){
  loader=document.createElement('div');loader.className='msg';
  const stepsHtml=_currentLoadingPhases().map((p,i)=>(
    '<div class="ml-step '+(i===0?'active':'pending')+'" data-step="'+i+'">'+
      '<span class="ml-mark">'+(i===0?'▸':'◌')+'</span>'+
      '<span class="ml-label">'+p+'</span>'+
    '</div>'
  )).join('');
  loader.innerHTML=
    '<div class="msg-head"><div class="av av-ai">✦</div><span>Connect AI</span><span class="msg-time">'+getTime()+'</span></div>'+
    '<div class="ml-loader">'+
      '<div class="ml-head"><span class="ml-head-dot"></span><span>NEURAL CORE · ACTIVE</span><span class="ml-head-bar"></span><span class="ml-head-spinner"></span></div>'+
      '<div class="ml-steps" id="mlSteps">'+stepsHtml+'</div>'+
      '<div class="ml-bar"><div class="ml-bar-fill" id="mlBarFill"></div></div>'+
      '<div class="ml-meta"><span>OFFLINE · LOCAL LLM</span><span class="ml-meta-elapsed" id="mlElapsed">0s</span></div>'+
    '</div>';
  chat.appendChild(loader);scrollChatToBottomIfNear();thinkingBar.classList.add('active');
  /* 단계 전환 + 막대 채움. 마지막 단계는 LLM 토큰이 실제로 들어오기 시작할 때까지
     활성 유지 → 토큰 도착하면 hideLoader가 정리. */
  let phase=0;
  _loaderStart=Date.now();
  const stepsEl=loader.querySelector('#mlSteps');
  const barEl=loader.querySelector('#mlBarFill');
  const elapsedEl=loader.querySelector('#mlElapsed');
  const setPhase=(p)=>{
    if(!stepsEl) return;
    const items=stepsEl.querySelectorAll('.ml-step');
    items.forEach((el,i)=>{
      el.classList.remove('done','active','pending');
      const mark=el.querySelector('.ml-mark');
      if(i<p){ el.classList.add('done'); if(mark) mark.textContent='✓'; }
      else if(i===p){ el.classList.add('active'); if(mark) mark.textContent='▸'; }
      else { el.classList.add('pending'); if(mark) mark.textContent='◌'; }
    });
    if(barEl){
      const pct=Math.min(96,((p+1)/_currentLoadingPhases().length)*100 - 4);
      barEl.style.width=pct+'%';
    }
  };
  setPhase(0);
  if(_loaderTimer) clearInterval(_loaderTimer);
  _loaderTimer=setInterval(()=>{
    phase=Math.min(phase+1,_currentLoadingPhases().length-1);
    setPhase(phase);
  },2200);
  if(_loaderElapsedTimer) clearInterval(_loaderElapsedTimer);
  _loaderElapsedTimer=setInterval(()=>{
    if(elapsedEl) elapsedEl.textContent=_formatElapsed(Date.now()-_loaderStart);
  },500);
}
function hideLoader(){
  if(_loaderTimer){clearInterval(_loaderTimer);_loaderTimer=null;}
  if(_loaderElapsedTimer){clearInterval(_loaderElapsedTimer);_loaderElapsedTimer=null;}
