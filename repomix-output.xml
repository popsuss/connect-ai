  }
  if (filtered.length === 0) {
    body.innerHTML =
      '<div class="sessions-empty">'+
        '<div class="sessions-empty-glyph">⌕</div>'+
        '<div class="sessions-empty-title">"'+_escapeHtml(_sessionsFilter)+'" 결과 없음</div>'+
        '<div class="sessions-empty-hint">다른 키워드로 시도하거나 위 ✕로 검색을 지우세요.</div>'+
