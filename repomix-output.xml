/* ──────────── Loading / pulse ──────────── */
.skeleton {
  position: relative;
  overflow: hidden;
  background: rgba(255, 255, 255, 0.04);
  border-radius: 8px;
}
.skeleton::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.1), transparent);
  animation: shimmer 1.6s linear infinite;
}
@keyframes shimmer {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}

/* ──────────── Live badge (when watcher running) ──────────── */
.live {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 4px 10px;
  background: rgba(52, 211, 153, 0.12);
  border: 1px solid rgba(52, 211, 153, 0.3);
  border-radius: 999px;
  font-size: 0.7rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  color: var(--emerald);
  text-transform: uppercase;
}
.live::before {
  content: '';
  width: 6px; height: 6px; border-radius: 50%;
  background: var(--emerald);
  box-shadow: 0 0 8px var(--emerald);
  animation: blink 1.2s ease-in-out infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.4; }
}

/* ──────────── New payment burst ──────────── */
.burst {
  position: fixed;
  top: 30%; left: 50%;
  transform: translate(-50%, -50%);
  z-index: 100;
  pointer-events: none;
  text-align: center;
  opacity: 0;
}
.burst.show { animation: burstIn 2.4s ease-out forwards; }
@keyframes burstIn {
  0% { opacity: 0; transform: translate(-50%, -50%) scale(0.4); }
  15% { opacity: 1; transform: translate(-50%, -50%) scale(1.15); }
  25% { transform: translate(-50%, -50%) scale(1); }
  80% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -80%) scale(1); }
}
.burst .big {
  font-size: 4rem;
  font-weight: 900;
  background: linear-gradient(135deg, var(--cyan-glow), var(--violet-glow), var(--amber));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  text-shadow: 0 0 80px var(--cyan);
  margin-bottom: 6px;
}
.burst .sub {
  font-size: 1.1rem;
  font-weight: 800;
  color: var(--cyan-glow);
  letter-spacing: 0.05em;
  text-shadow: 0 0 12px var(--cyan);
}

@media (max-width: 800px) {
  .kpi-strip { grid-template-columns: repeat(2, 1fr); }
  .row { grid-template-columns: 1fr; }
  .hero-info h1 { font-size: 1.4rem; }
  .kpi-value { font-size: 1.8rem; }
  .donut-svg { width: 160px; height: 160px; }
}

/* ───────── v2.89.150 — KPI count-up 완료 시 폭발 효과 ───────── */
.kpi.complete-burst {
  animation: kpiBurst 0.8s cubic-bezier(0.2, 0.8, 0.2, 1);
}
@keyframes kpiBurst {
  0% { transform: scale(1); box-shadow: 0 0 0 rgba(34, 211, 238, 0); }
  30% { transform: scale(1.08); box-shadow: 0 0 40px rgba(34, 211, 238, 0.6); }
  100% { transform: scale(1); box-shadow: 0 0 0 rgba(34, 211, 238, 0); }
}

/* 도넛 slice hover — 강조 효과 */
.donut-svg circle {
  transition: stroke-width 0.2s, filter 0.2s;
}
.donut-svg circle:hover {
  stroke-width: 22;
  filter: drop-shadow(0 0 12px currentColor) brightness(1.2);
  cursor: pointer;
}

/* 거래 피드 hover 시 더 명확한 펄스 */
.tx:hover .tx-amount {
  transform: scale(1.1);
  transition: transform 0.18s;
}

/* Hero 매트릭스 효과 — 백그라운드 글로우 ripple */
.hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 80% 50%, rgba(167, 139, 250, 0.08), transparent 40%);
  pointer-events: none;
  animation: heroRipple 6s ease-in-out infinite;
}
@keyframes heroRipple {
  0%, 100% { opacity: 0.6; }
  50% { opacity: 1; }
}
