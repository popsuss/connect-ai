  min-width:16px;text-align:center;
}
.tl-chip.tl-active .tl-count{background:rgba(0,255,65,.25)}

/* ───────── v2.89.142 — Revenue Command Center 카드 ───────── */
.revenue-card {
  position: relative;
  overflow: hidden;
  background:
    radial-gradient(ellipse at 0% 0%, rgba(34, 211, 238, 0.12), transparent 50%),
    radial-gradient(ellipse at 100% 100%, rgba(167, 139, 250, 0.10), transparent 50%),
    linear-gradient(145deg, rgba(11, 17, 48, 0.85), rgba(19, 27, 74, 0.6));
  border: 1px solid rgba(103, 232, 249, 0.25);
  box-shadow: 0 12px 40px rgba(34, 211, 238, 0.08);
}
.revenue-card::before {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 2px;
  background: linear-gradient(90deg, transparent, #22d3ee 30%, #a78bfa 70%, transparent);
  opacity: 0.7;
}

/* Glyph rain micro layer */
.rev-glyph-rain {
  position: absolute; inset: 0;
  pointer-events: none;
  opacity: 0.05;
  background-image:
    repeating-linear-gradient(180deg,
      transparent 0px, transparent 18px,
      rgba(103, 232, 249, 0.4) 18px, rgba(103, 232, 249, 0.4) 19px);
  mask-image: linear-gradient(180deg, transparent, black 30%, black 80%, transparent);
  -webkit-mask-image: linear-gradient(180deg, transparent, black 30%, black 80%, transparent);
  animation: revRainDrift 14s linear infinite;
}
@keyframes revRainDrift {
  from { background-position: 0 0; }
  to { background-position: 0 60px; }
}

.rev-inner {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: 1.4fr 1.2fr 1fr auto;
  align-items: center;
  gap: 24px;
  padding: 6px 4px;
}

/* Header */
.rev-eyebrow {
  font-size: 0.68rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: #67e8f9;
  font-weight: 800;
  margin-bottom: 8px;
  text-shadow: 0 0 12px rgba(34, 211, 238, 0.5);
  display: flex; align-items: center; gap: 10px;
}
.rev-live {
  display: inline-flex; align-items: center; gap: 5px;
  padding: 2px 8px;
  background: rgba(52, 211, 153, 0.15);
  border: 1px solid rgba(52, 211, 153, 0.35);
  border-radius: 999px;
  color: #34d399;
  font-size: 0.65rem;
  letter-spacing: 0.15em;
}
.rev-pulse {
  width: 6px; height: 6px; border-radius: 50%;
  background: #34d399;
  box-shadow: 0 0 8px #34d399;
  animation: revPulse 1.4s ease-in-out infinite;
}
@keyframes revPulse {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: 0.3; transform: scale(0.7); }
}
.rev-title {
  font-size: 1.65rem;
  font-weight: 900;
  background: linear-gradient(135deg, #fff, #67e8f9, #c4b5fd);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  letter-spacing: -0.01em;
  margin-bottom: 4px;
  line-height: 1.1;
}
.rev-sub {
  font-size: 0.84rem;
  color: #94a3b8;
}

/* KPI strip */
.rev-kpis {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10px;
}
.rev-kpi {
  padding: 12px 14px;
  background: rgba(255, 255, 255, 0.03);
  border: 1px solid rgba(103, 232, 249, 0.12);
  border-radius: 12px;
  position: relative;
  overflow: hidden;
  transition: all 0.25s;
}
.rev-kpi:hover {
  border-color: rgba(103, 232, 249, 0.4);
  background: rgba(34, 211, 238, 0.06);
  transform: translateY(-2px);
}
.rev-kpi::after {
  content: '';
  position: absolute;
  top: 0; left: 0; right: 0;
  height: 1px;
  background: linear-gradient(90deg, transparent, #22d3ee, transparent);
  opacity: 0.5;
}
.rev-kpi-l {
  font-size: 0.65rem;
  letter-spacing: 0.15em;
  text-transform: uppercase;
  color: #64748b;
  font-weight: 700;
  margin-bottom: 4px;
}
.rev-kpi-v {
  font-size: 1.35rem;
  font-weight: 900;
  font-variant-numeric: tabular-nums;
  background: linear-gradient(135deg, #fff, #67e8f9);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  line-height: 1;
  letter-spacing: -0.02em;
}
.rev-skeleton .rev-kpi-v {
  background: rgba(255, 255, 255, 0.06);
  -webkit-background-clip: initial;
  background-clip: initial;
  color: transparent;
  border-radius: 4px;
  position: relative;
  overflow: hidden;
}
.rev-skeleton .rev-kpi-v::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg, transparent, rgba(34, 211, 238, 0.15), transparent);
  animation: revShimmer 1.6s linear infinite;
}
@keyframes revShimmer {
  from { transform: translateX(-100%); }
  to { transform: translateX(100%); }
}

/* Sparkline */
.rev-spark {
  height: 60px;
  padding: 4px 0;
}
.rev-spark svg { width: 100%; height: 100%; }
.rev-spark .area { fill: url(#revSparkGrad); }
.rev-spark .line {
  stroke: #67e8f9;
  stroke-width: 2;
  fill: none;
  filter: drop-shadow(0 0 5px #22d3ee);
}
.rev-spark .peak {
  fill: #fbbf24;
  filter: drop-shadow(0 0 6px #fbbf24);
}

/* Actions */
.rev-actions {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 200px;
}
.rev-btn {
  position: relative;
  overflow: hidden;
  padding: 12px 18px;
  border: none;
  border-radius: 12px;
  font-size: 0.92rem;
  font-weight: 800;
  letter-spacing: 0.02em;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  transition: all 0.2s;
  font-family: inherit;
}
.rev-btn.primary {
  background: linear-gradient(135deg, #0891b2, #22d3ee);
  color: #fff;
  box-shadow:
    0 4px 18px rgba(34, 211, 238, 0.4),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
}
.rev-btn.primary:hover {
  transform: translateY(-2px);
  box-shadow:
    0 8px 28px rgba(34, 211, 238, 0.6),
    inset 0 1px 0 rgba(255, 255, 255, 0.3);
}
.rev-btn.primary:active {
  transform: translateY(0);
}
.rev-btn-glow {
  position: absolute;
  inset: -4px;
  background: linear-gradient(135deg, #22d3ee, #a78bfa);
  filter: blur(20px);
  opacity: 0.4;
  z-index: -1;
  animation: revGlowPulse 3s ease-in-out infinite;
}
@keyframes revGlowPulse {
  0%, 100% { opacity: 0.3; }
  50% { opacity: 0.6; }
}
.rev-btn-arrow {
  transition: transform 0.2s;
}
.rev-btn.primary:hover .rev-btn-arrow {
  transform: translateX(4px);
}
.rev-btn.ghost {
  background: rgba(255, 255, 255, 0.04);
  border: 1px solid rgba(167, 139, 250, 0.25);
  color: #c4b5fd;
  font-size: 0.82rem;
}
.rev-btn.ghost:hover {
  background: rgba(167, 139, 250, 0.1);
  border-color: rgba(167, 139, 250, 0.5);
  transform: translateY(-1px);
}

@media (max-width: 1000px) {
  .rev-inner {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .rev-spark { display: none; }
}
</file>

<file path="assets/prompts/ceo-planner.md">
당신은 "{{COMPANY}}"의 CEO입니다. 1인 AI 기업의 사령관이자 오케스트레이터입니다.

당신의 팀(전문 에이전트):
- youtube   (Head of YouTube)         : 유튜브 채널 운영, 영상 기획, 트렌드, 썸네일 브리프
- instagram (Head of Instagram)       : 릴스/피드, 캡션, 해시태그, 게시 시간, 인게이지먼트
- designer  (Lead Designer)           : 디자인 브리프, 썸네일·브랜드 비주얼, 컬러/타이포
- developer (코다리 · 시니어 풀스택 엔지니어): 코드 작성·편집·디버깅, 자동화 스크립트, API 통합, 웹사이트, 테스트, git, 자기 검증 루프 (Claude Code 수준)
- business  (Head of Business)        : 수익화, 가격, 비즈니스 전략·분석, KPI
- secretary (Personal Assistant)      : 일정·할 일, 작업 요약, 텔레그램 보고, 데일리 브리핑
- editor    (루나 · 사운드 감독)         : BGM 자동 생성(MusicGen/ACE-Step), 사운드 디자인, 영상-음악 합성, 오디오 후처리
- writer    (Copywriter)              : 카피라이팅, 영상 스크립트, 캡션, 블로그, 후크
- researcher(Trend & Data Researcher) : 트렌드/경쟁사 리서치, 데이터 수집·요약, 사실 확인

사용자가 한 줄 명령을 내리면, 당신은 어떤 에이전트들을 어떤 순서로 동원할지 결정합니다.

⚠️ 반드시 아래 JSON 형식으로만 출력하세요. 다른 텍스트(설명, ```json 펜스, 머리말, 꼬리말)는 절대 포함 금지.

{
  "brief": "이번 작업이 무엇인지 2~3줄 한국어 요약",
  "tasks": [
    {"agent": "youtube", "task": "구체적이고 실행 가능한 한국어 지시"}
  ]
}

🛑 **최소 동원 원칙 — 절대 위반 금지**:
1. **단순 데이터 조회·정보 확인 명령은 데이터 에이전트 1명만**. 예: "내 채널 분석", "구독자 수", "오늘 일정", "최근 영상" → tasks 배열에 1명. 추가 분석 에이전트(researcher/business/designer/writer) 절대 추가 금지. 사용자가 추가 분석을 *명시적으로* 요청해야만 추가.
2. **창작·기획 명령일 때만 multi-agent**. 예: "영상 기획해줘", "썸네일 만들어", "수익화 전략 짜줘" → 관련 에이전트 2~3명. 5명 이상 절대 금지.
3. **상관없는 에이전트 끌어오지 마라**. 사용자 명령이 유튜브 데이터인데 designer/writer 부르는 건 즉시 금지. 사용자가 "디자인"·"카피"·"썸네일" 같은 단어를 *직접* 썼을 때만.

데이터 수집 키워드 매칭 (해당 에이전트만 1명):
- "유튜브"·"YouTube"·"내 채널"·"구독자"·"조회수"·"영상 분석" → youtube 1명만
- "인스타"·"릴스"·"피드" → instagram 1명만
- "캘린더"·"일정"·"오늘 미팅" → secretary 1명만

기타 규칙:
- 논리적 순서로 정렬 (예: 데이터 수집 → 분석 → 창작 — 사용자가 그 모두를 요청한 경우에만)
- 각 task는 모호함 없이 구체적·실행가능하게
- JSON 외 텍스트는 단 한 글자도 출력 금지
- 데이터 수집 없이 researcher/business만 호출하면 LLM이 가짜 분석을 출력합니다 — 절대 금지
</file>

