  transition:border-color .2s,transform .2s,box-shadow .2s;
}
.svc-card::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,var(--accent-glow),transparent);opacity:.4}
.svc-card.connected{border-color:rgba(52,211,153,.22)}
.svc-card.connected::before{background:linear-gradient(90deg,transparent,rgba(52,211,153,.4),transparent);opacity:.55}
.svc-head{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.svc-icon{
  width:42px;height:42px;border-radius:11px;flex-shrink:0;
  background:rgba(255,255,255,.04);border:1px solid var(--line);
  display:flex;align-items:center;justify-content:center;font-size:20px;
}
.svc-name{font-size:14.5px;font-weight:700;color:var(--bright);letter-spacing:-.2px}
.svc-status{
  font-size:10.5px;font-weight:600;padding:2px 9px;border-radius:999px;
  background:rgba(255,255,255,.04);color:var(--dim);border:1px solid var(--line);
  display:inline-flex;align-items:center;gap:5px;margin-left:auto;
}
.svc-status.connected{background:rgba(52,211,153,.12);color:var(--ok);border-color:rgba(52,211,153,.3)}
.svc-status.connected::before{content:'';width:5px;height:5px;border-radius:50%;background:var(--ok);box-shadow:0 0 6px var(--ok)}
.svc-status.coming{background:rgba(251,191,36,.10);color:var(--gold);border-color:rgba(251,191,36,.3)}
.svc-card.coming{opacity:.65;border-style:dashed}
.svc-card.coming .svc-icon{filter:grayscale(.4)}
.svc-card.coming .svc-field input{background:rgba(0,0,0,.18);color:var(--dim);cursor:not-allowed}
.svc-coming-banner{
  margin-top:14px;padding:10px 14px;border-radius:9px;text-align:center;
  font-size:11.5px;color:var(--gold);font-weight:600;
  background:rgba(251,191,36,.06);border:1px dashed rgba(251,191,36,.3);
  letter-spacing:.3px;
}
.svc-summary{font-size:12px;color:var(--dim);line-height:1.55;margin-bottom:14px}
.svc-fields{display:flex;flex-direction:column;gap:10px}
.svc-field{display:flex;flex-direction:column;gap:5px}
.svc-field label{font-size:11px;color:var(--dim);font-weight:600;letter-spacing:.3px;display:flex;align-items:center;gap:6px}
.svc-input-wrap{position:relative}
.svc-field input{
  width:100%;background:rgba(0,0,0,.3);
  border:1px solid var(--line);border-radius:9px;
  padding:9px 38px 9px 12px;color:var(--text);font-family:inherit;font-size:12.5px;
  font-variant-numeric:tabular-nums;
  transition:border-color .2s,box-shadow .2s;
}
.svc-field input:focus{outline:none;border-color:var(--accent-glow);box-shadow:0 0 0 3px rgba(251,191,36,.10)}
.svc-field input::placeholder{color:rgba(255,255,255,.18)}
.svc-eye{
  position:absolute;right:6px;top:50%;transform:translateY(-50%);
  background:transparent;border:none;color:var(--dim);
  width:28px;height:28px;border-radius:7px;cursor:pointer;font-size:13px;
  display:inline-flex;align-items:center;justify-content:center;
}
.svc-eye:hover{color:var(--text);background:rgba(255,255,255,.04)}
.svc-help{font-size:10.5px;color:var(--dim);line-height:1.5;opacity:.85}
.svc-actions{display:flex;gap:8px;margin-top:14px}
.btn{
  font-family:inherit;font-size:12.5px;font-weight:600;
  padding:9px 14px;border-radius:9px;cursor:pointer;
  background:rgba(255,255,255,.03);color:var(--text);border:1px solid var(--line-2);
  transition:all .18s;
  display:inline-flex;align-items:center;gap:6px;
}
.btn:hover{background:rgba(255,255,255,.06);border-color:var(--accent-glow);transform:translateY(-1px)}
.btn.primary{
  background:linear-gradient(135deg,var(--accent),var(--accent-2));
  color:#001a0d;border-color:transparent;font-weight:700;
  box-shadow:0 4px 14px var(--accent-glow);
}
.btn.primary:hover{box-shadow:0 8px 24px var(--accent-glow);transform:translateY(-2px)}
.btn.ghost{background:transparent;color:var(--dim)}
.btn.ghost:hover{color:var(--text);background:rgba(255,255,255,.04)}
.toast{
  position:fixed;bottom:24px;left:50%;transform:translateX(-50%);
  background:var(--bg-3);border:1px solid var(--accent-glow);
  color:var(--text);padding:10px 18px;border-radius:10px;font-size:12.5px;
  box-shadow:0 12px 36px rgba(0,0,0,.6);
  opacity:0;pointer-events:none;transition:opacity .25s,transform .25s;z-index:100;
}
.toast.show{opacity:1;transform:translateX(-50%) translateY(-4px)}
.toast.err{border-color:rgba(255,82,96,.5)}
::-webkit-scrollbar{width:8px;height:8px}
::-webkit-scrollbar-thumb{background:var(--line-2);border-radius:4px}
</file>

