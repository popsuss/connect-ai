/* ===== Agent panel — clicking any card opens this ===== */
/* All agents now live — Mission editing, Retrieval Strategy (Self-RAG /
   Graph RAG), agent memory, and brain context bridge all work agent-agnostic.
   YouTube has the deepest tool catalog; the others just show empty Skills. */
const AGENT_LIVE = {ceo:true, youtube:true, instagram:true, designer:true, developer:true, business:true, secretary:true, editor:true, writer:true, researcher:true};
let _agentPanelOpen = false;
let _agentPanelLoadHandler = null;
let _toolConfigLoadHandler = null;
let _currentPanelAgent = null;

function showAgentPanel(agent){
  /* v2.87.5 — 방어: 이전 호출에서 어딘가 throw가 나서 _agentPanelOpen이
     true로 박혀있으면, DOM에 백드롭이 없는데도 패널이 안 열려서 사용자한테
     "아무 반응 없음"으로 보임. DOM 검사로 실제 열려있는지 확인 후 reset. */
  if(_agentPanelOpen){
    if(document.querySelector('.ap-backdrop')){
      return; /* 진짜로 열려있음 — 중복 방지 */
    }
    /* 플래그만 박혀있고 DOM은 비어있음 — 강제 reset */
    _agentPanelOpen = false;
    _currentPanelAgent = null;
    _agentPanelLoadHandler = null;
  }
  try {
    _showAgentPanelInner(agent);
  } catch(err){
    /* 패널 렌더 중 throw나면 플래그·핸들러 다 reset해서 다음 클릭은 살아있게 */
    _agentPanelOpen = false;
    _currentPanelAgent = null;
    _agentPanelLoadHandler = null;
    try { document.querySelectorAll('.ap-backdrop').forEach(b=>b.remove()); } catch(_){}
    console.error('[showAgentPanel] render failed:', err);
    try { vscode.postMessage({type:'log', msg:'showAgentPanel error: '+(err && err.message || err)}); } catch(_){}
  }
}
function _showAgentPanelInner(agent){
  _agentPanelOpen = true;
  _currentPanelAgent = agent;
  const bd = document.createElement('div');
  bd.className = 'ap-backdrop';
  bd.style.setProperty('--ag-color', agent.color);
  bd.style.setProperty('--ag-color-glow', agent.color + '33');
  const live = !!AGENT_LIVE[agent.id];

  /* Hero band — full-width photo, name overlaid on bottom gradient. Custom
     images take the photo aesthetic; agents without one get an oversized
     emoji on a colored gradient. Locked agents are silhouetted with a 🔒. */
  const heroClasses = ['ap-hero'];
  if (agent.portraitIsCustom) heroClasses.push('ap-hero-custom');
  if (!live) heroClasses.push('ap-hero-locked');
  const heroInner = agent.portrait
    ? '<div class="'+heroClasses.join(' ')+'" style="background-image:url(\''+agent.portrait+'\')"></div>'
    : '<div class="'+heroClasses.join(' ')+'"><div class="ap-hero-emoji">'+agent.emoji+'</div></div>';

  const statusPill = live
    ? '<div class="ap-status-pill">ACTIVE</div>'
    : '';

  /* First-person greeting — what the agent would say if you walked into
     their office. Agents have personality; we lean into it instead of cold
     section labels. */
  const firstSpec = (agent.specialty || '').split(/[·,，]/)[0].trim();
  /* v2.89.85 — 받침 있으면 '이에요' (영숙이에요), 없으면 '예요' (루나예요·레오예요).
     마지막 한글 음절의 (charCode - 0xAC00) % 28 이 0이면 받침 없음. */
  const _lastChar = (agent.name || '').slice(-1);
  const _code = _lastChar.charCodeAt(0);
  const _hasJongsung = _code >= 0xAC00 && _code <= 0xD7A3 && (_code - 0xAC00) % 28 !== 0;
  const _hi = '안녕하세요, ' + agent.name + (_hasJongsung ? '이에요. ' : '예요. ');
  const greetingByRole = {
    youtube:    _hi + (firstSpec || '유튜브 채널') + ' 맡고 있어요.',
    instagram:  _hi + (firstSpec || '인스타 운영') + ' 도와드릴게요.',
    designer:   _hi + (firstSpec || '브랜드·시각 디자인') + ' 작업하고 있어요.',
    developer:  _hi + (firstSpec || '코드·자동화') + ' 처리해드려요.',
    business:   _hi + (firstSpec || '수익·전략') + ' 같이 봐드릴게요.',
    secretary:  _hi + (firstSpec || '일정·할 일') + ' 챙기고, 회사 전체 소통 정리해요.',
    editor:     _hi + (firstSpec || 'BGM 자동 생성·사운드 디자인') + ' 맡고 있어요.',
    writer:     _hi + (firstSpec || '카피·스크립트') + ' 써드려요.',
    researcher: _hi + (firstSpec || '리서치·사실 확인') + ' 맡고 있어요.',
    ceo:        _hi + '회사 전체 의사결정을 맡고 있어요.',
  };
  const greetText = greetingByRole[agent.id] || (_hi);
  const greet = live
    ? '<div class="ap-greet"><span class="ap-greet-quote">' + esc(greetText) + '</span><span class="ap-greet-sub">아래에서 미션을 알려주시면 그 방향으로 일할게요.</span></div>'
    : '';

  /* Clean hero — photo, then identity stack BELOW (no overlay = no overlap).
     Tagline removed; the greeting bubble below already answers "what does
     this agent do" in the agent's own voice. */
  const headHtml = '<button class="ap-close" id="apClose" aria-label="닫기">×</button>'
    + '<div class="ap-head">'
    +   heroInner
    +   '<div class="ap-identity">'
    +     '<div class="ap-name">'+esc(agent.name)+'</div>'
    +     '<div class="ap-role"><span class="ap-role-emoji">'+agent.emoji+'</span>'+esc(agent.role||'')+'</div>'
    +     statusPill
    +   '</div>'
    + '</div>'
    + greet;

  let bodyHtml;
  if(live){
    /* Secretary gets a Telegram-onboard CTA banner (hidden until load handler
       confirms it's not yet connected). Other agents don't see this. */
    const cta = (agent.id === 'secretary')
      ? '<div class="ap-cta" id="apTelegramCta" style="display:none" role="button"><span class="ap-cta-icon">📨</span><span class="ap-cta-text"><strong>텔레그램이 아직 연결 안 됐어요</strong><br><span class="ap-cta-sub">3단계 마법사로 끝낼 수 있어요 — 폰으로 회사 보고받기</span></span><span class="ap-cta-arrow">→</span></div>'
      : '';
    /* 4-zone information hierarchy (v2.64):
         ① Hero (above)         — who is this agent
         ② 지금 하는 일          — collapsed preview, expand to edit
         ③ 능력 (Skills)         — primary, always-visible tools
         ④ 고급 설정 (접힘)       — RAG strategy + 24h auto-cycle, opt-in
       The "easy yet professional" idea: first click gives a 3-second read
       (name → role → tagline → current mission preview → tools), and only
       users who want to tinker open the Advanced section. */
    bodyHtml = '<div class="ap-body">'
      + cta
      /* ② Mission — collapsed preview + ✏ expand. */
      + '<div class="ap-section ap-mission" id="apMissionSection">'
      +   '<button class="ap-mission-head" id="apMissionHead" type="button">'
      +     '<span class="ap-mission-pin">📌</span>'
      +     '<span class="ap-mission-preview" id="apMissionPreview">미션 불러오는 중…</span>'
      +     '<span class="ap-mission-edit" title="펼쳐서 편집">✏</span>'
      +   '</button>'
